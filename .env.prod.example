POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=bronzebrawldb
VITE_API_BASE_URL=/api
# Generate a long random value; never commit the real token.
REPLAY_ADMIN_TOKEN=change-me-replay-operator-token
REPLAY_STORAGE_DIR=/var/lib/bronzebrawl/replays
SIPS_PER_SHOT=5
SIPS_PER_CHUG=15
DIFFICULTY_EASY=0.5
DIFFICULTY_BASELINE=1
DIFFICULTY_HARD=1.5
DIFFICULTY_TERROR=2
# Optional JSON object keyed by reward ID; overrides catalogue amounts, odds, weights or time.
REWARD_CATALOG_OVERRIDES={}
